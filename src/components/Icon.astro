export type IconName = keyof typeof ICONS;

interface Props extends astroHTML.JSX.HTMLAttributes {
  name: IconName;
  size?: number;
}

const { name, size = 20, class: cls, ...rest } = Astro.props;
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  {...rest}
  set:html={ICONS[name]}
/>
