---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { url, absUrl, NSFW_ENABLED } from '../lib/env';

interface Props {
  title: string;
  description?: string;
  active?: 'course' | 'nodes' | 'tags' | 'troubleshooting' | 'resources' | 'tools' | 'search';
  /** noindex：不进搜索引擎 */
  noindex?: boolean;
  /** noSearch：不进 Pagefind 索引（搜索页、404 这类没有可查内容的页面） */
  noSearch?: boolean;
  /** wide：内容区用满容器宽度（列表页、带侧栏的课程页）；否则是居中的文章列 */
  wide?: boolean;
}

const {
  title,
  description = 'Anima × ComfyUI 循序渐进课程：固定种子、一次只改一个变量、用对照图说话。教方法，不教参数。',
  active = '',
  noindex = false,
  noSearch = false,
  wide = false,
} = Astro.props;

/** 主导航。搜索单独做成右侧的图标按钮（带 Ctrl / ⌘ + K 快捷键），不占导航位。 */
const NAV: Array<[NonNullable<Props['active']>, string, string]> = [
  ['course', '课程', url('')],
  ['nodes', '节点', url('nodes/')],
  ['tags', '标签', url('tags/')],
  ['troubleshooting', '排错', url('troubleshooting/')],
  ['resources', '资源', url('resources/')],
  ['tools', '工具', url('tools/')],
];
const SEARCH_URL = url('search/');

const fullTitle = title ? `${title} · Anima × ComfyUI 课程` : 'Anima × ComfyUI 学习课程';

/** 分享卡片的缩略图（node scripts/og-cover.mjs 生成，1200 × 630） */
const OG_IMAGE = absUrl('og-cover.png');
const OG_IMAGE_ALT = 'Anima × ComfyUI 学习课程：以 Anima 为载体，学会 AI 生图的一般方法。教方法，不教参数。';
/**
 * 规范地址与分享标签只给能被收录的页面：成人附录（noindex）不请爬虫来，搜索页和 404（noSearch）没有可预览的内容。
 * 构建时 Astro.url 的路径已经带 base；目录页补上结尾的 /，和 GitHub Pages 实际提供的地址一致。
 */
const social = !noindex && !noSearch;
const here = Astro.url.pathname;
const canonical = new URL(/\.[a-z0-9]+$/i.test(here) || here.endsWith('/') ? here : `${here}/`, Astro.site ?? Astro.url.origin).href;

/** 品牌标记：一块"图"（山 + 日），底色从工作流轨的蓝渐变到提示词轨的品红 */
const brandMark = (gid: string) =>
  `<svg class="brand-mark" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false"><defs><linearGradient id="${gid}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#3b5bdb"/><stop offset="1" stop-color="#be185d"/></linearGradient></defs><rect width="24" height="24" rx="6" fill="url(#${gid})"/><path d="M6.4 16.8 10 12.2l2.6 2.9 1.9-2.1 3.1 3.8z" fill="#fff"/><circle cx="15.7" cy="8.5" r="1.7" fill="#fff"/></svg>`;
---

<!doctype html>
<html lang="zh-CN" class="no-js" data-pagefind-ignore={noSearch ? 'all' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {social && (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Anima × ComfyUI 学习课程" />
        <meta property="og:locale" content="zh_CN" />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={OG_IMAGE} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={OG_IMAGE_ALT} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={OG_IMAGE} />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <script is:inline>
      // 在首次绘制前应用手动选择的配色，避免闪一下；同时标记"JS 可用"。
      (function () {
        var el = document.documentElement;
        el.classList.remove('no-js');
        try {
          var t = localStorage.getItem('anima:theme');
          if (t === 'light' || t === 'dark') el.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href={url('')}>
          <Fragment set:html={brandMark('brand-g')} />
          <span>Anima × ComfyUI 课程<small>教方法，不教参数</small></span>
        </a>
        <nav id="site-nav" class="site-nav" aria-label="主导航">
          {NAV.map(([key, label, href]) => (
            <a href={href} class:list={[{ active: key === active }]} aria-current={key === active ? 'page' : undefined}>
              {label}
            </a>
          ))}
        </nav>
        <div class="header-actions">
          <a
            class="icon-btn search-btn"
            href={SEARCH_URL}
            aria-label="搜索（快捷键 Ctrl K）"
            aria-current={active === 'search' ? 'page' : undefined}
            title="搜索  Ctrl / ⌘ + K"
          >
            <Icon name="search" />
            <kbd class="search-kbd" aria-hidden="true">Ctrl K</kbd>
          </a>
          <button
            type="button"
            class="icon-btn theme-toggle"
            data-theme-toggle
            aria-label="切换配色"
            title="配色：跟随系统"
          >
            <Icon name="monitor" size={20} data-theme-icon="system" />
            <Icon name="sun" size={20} data-theme-icon="light" />
            <Icon name="moon" size={20} data-theme-icon="dark" />
          </button>
          <span class="sr-only" aria-live="polite" data-theme-live></span>
        </div>
      </div>
    </header>

    <!-- 搜索索引只收 <main> 里的内容（data-pagefind-body）：页头导航、页脚不在其中；
         页内的面包屑、目录、翻页器是每页都有的导航文字，各自带 data-pagefind-ignore -->
    <main id="main" class="page" tabindex="-1" data-pagefind-body>
      <div class:list={['content', { wide }]}><slot /></div>
    </main>

    <footer class="site-footer">
      <div class="inner">
        <div class="footer-brand">
          <a class="brand" href={url('')}>
            <Fragment set:html={brandMark('brand-g-footer')} />
            <span>Anima × ComfyUI 课程</span>
          </a>
          <span>以 Anima 为载体学 AI 生图的一般方法：14 天、六个阶段、一条双轨路径。</span>
        </div>
        <div>
          <p class="footer-col-title">导航</p>
          <ul class="footer-links">
            {NAV.map(([, label, href]) => (
              <li><a href={href}>{label}</a></li>
            ))}
            <li><a href={SEARCH_URL}>搜索</a></li>
          </ul>
        </div>
        <div>
          <p class="footer-col-title">说明</p>
          <ul class="footer-links">
            <li><span>各页标注核实日期；参数均为起点值，以固定种子实测为准。</span></li>
            {NSFW_ENABLED && <li><a href={url('nsfw/')}>成人附录（需确认）</a></li>}
            <li><a href="https://github.com/" rel="noopener">仓库</a></li>
          </ul>
        </div>
      </div>
    </footer>

    <script>
      // —— 配色：跟随系统 → 浅色 → 深色，循环切换；选择存 localStorage，样式由 [data-theme] 驱动 ——
      const THEME_KEY = 'anima:theme';
      const ORDER = ['system', 'light', 'dark'] as const;
      type Mode = (typeof ORDER)[number];
      const LABEL: Record<Mode, string> = { system: '跟随系统', light: '浅色', dark: '深色' };

      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const live = document.querySelector<HTMLElement>('[data-theme-live]');

      const current = (): Mode => {
        const t = root.getAttribute('data-theme');
        return t === 'light' || t === 'dark' ? t : 'system';
      };
      const sync = () => {
        const m = current();
        if (toggle) {
          toggle.title = `配色：${LABEL[m]}（点击切换）`;
          toggle.setAttribute('aria-label', `切换配色，当前为${LABEL[m]}`);
        }
      };
      const apply = (next: Mode) => {
        if (next === 'system') root.removeAttribute('data-theme');
        else root.setAttribute('data-theme', next);
        try {
          if (next === 'system') localStorage.removeItem(THEME_KEY);
          else localStorage.setItem(THEME_KEY, next);
        } catch {
          /* 隐私模式下存不了：只对本次访问生效 */
        }
        if (live) live.textContent = `配色已切换为${LABEL[next]}`;
        sync();
      };
      toggle?.addEventListener('click', () => {
        apply(ORDER[(ORDER.indexOf(current()) + 1) % ORDER.length]);
      });
      sync();

      // —— 窄屏的导航横向滚动：把当前项滚到可见位置 ——
      const nav = document.getElementById('site-nav');
      const activeItem = nav?.querySelector<HTMLElement>('[aria-current="page"]');
      if (nav && activeItem) {
        nav.scrollLeft = activeItem.offsetLeft - (nav.clientWidth - activeItem.offsetWidth) / 2;
      }

      // —— Ctrl / ⌘ + K：全站跳到搜索页；已在搜索页则聚焦输入框 ——
      window.addEventListener(
        'keydown',
        (e) => {
          if (!(e.ctrlKey || e.metaKey) || e.altKey || e.shiftKey) return;
          if (e.key.toLowerCase() !== 'k') return;
          e.preventDefault();
          const input = document.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
          const searchUrl = document.querySelector<HTMLAnchorElement>('.search-btn')?.href;
          if (input) {
            input.focus();
            input.select();
          } else if (searchUrl) {
            window.location.href = searchUrl;
          }
        },
      );
    </script>
  </body>
</html>
