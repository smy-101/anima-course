---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import { getCollection, render } from 'astro:content';
import { url, emphasis } from '../../lib/env';

export async function getStaticPaths() {
  const entries = await getCollection('tags');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const lessons = (await getCollection('lessons')).sort(
  (a, b) => a.data.stage - b.data.stage || a.data.order - b.data.order,
);
const usedIn = lessons.filter((l) => l.data.tags.includes(entry.id));
const versions = d.versions
  ? [
      ['Base', d.versions.base],
      ['Aesthetic', d.versions.aesthetic],
      ['Turbo', d.versions.turbo],
    ].filter(([, v]) => v)
  : [];
const polarity = d.polarity === '皆可' ? '正向 / 负向皆可' : `${d.polarity}向`;
---

<Base title={d.tag} description={d.meaning} active="tags">
  <nav class="crumbs" aria-label="面包屑">
    <a href={url('tags/')}>标签字典</a>
    <span aria-hidden="true">›</span>
    <a href={url(`tags/#cat-${d.category}`)}>{d.category}</a>
  </nav>

  <header class="page-head">
    <h1><code>{d.tag}</code></h1>
    <div class="meta-row">
      <span class="pill">{d.category}</span>
      <span class={`pill ${d.polarity === '负' ? 'pill-danger' : d.polarity === '正' ? 'pill-ok' : ''}`}>{polarity}</span>
      {d.trap && <span class="pill pill-todo"><Icon name="triangle-alert" size={14} />陷阱标签</span>}
    </div>
    <p class="lead" set:html={emphasis(d.meaning)} />
  </header>

  {d.trap && (
    <div class="note note-warn">
      <div class="note-title">陷阱标签</div>
      这个词看起来是普通英文，但在 booru 里有精确含义。把它当形容词写进句子，整张图会被“吸”到那个特定样子。想要那个效果就<strong>有意</strong>用标签，否则别提。
    </div>
  )}

  <div class="prose">
    <Content />
  </div>

  {versions.length > 0 && (
    <section aria-labelledby="versions-h">
      <h2 id="versions-h">按版本</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>版本</th><th>用法</th></tr></thead>
          <tbody>
            {versions.map(([v, text]) => <tr><td><strong>{v}</strong></td><td>{text}</td></tr>)}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {usedIn.length > 0 && (
    <section aria-labelledby="usedin-h">
      <h2 id="usedin-h">出现在这些课程</h2>
      <ul>{usedIn.map((l) => <li><a href={url(`lessons/${l.id}/`)}>{l.data.title}</a></li>)}</ul>
    </section>
  )}

  {d.wiki && (
    <p>
      <a class="btn" href={d.wiki} rel="noopener" target="_blank">
        Danbooru wiki 词条<Icon name="link" size={16} />
      </a>
    </p>
  )}

  <SourceBadge sources={d.sources} verified={d.verified} />
</Base>
