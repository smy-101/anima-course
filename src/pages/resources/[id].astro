---
import Base from '../../layouts/Base.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import { getCollection, render } from 'astro:content';
import { url } from '../../lib/env';

export async function getStaticPaths() {
  const entries = await getCollection('resources');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---

<Base title={d.title} description={`${d.kind}：${d.title}`} active="resources" wide>
  <nav class="crumbs" aria-label="面包屑"><a href={url('resources/')}>资源</a></nav>
  <h1>{d.title}</h1>
  <p class="badges"><span class="pill">{d.kind}</span></p>
  <div class="prose">
    <Content />
  </div>
  <SourceBadge sources={d.sources} verified={d.verified} />
</Base>
