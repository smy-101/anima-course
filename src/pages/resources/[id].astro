---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import { getCollection, render } from 'astro:content';
import { url } from '../../lib/env';

export async function getStaticPaths() {
  const entries = await getCollection('resources');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---

<Base title={d.title} description={`${d.kind}：${d.title}`} active="resources" wide>
  <div class="lesson">
    <article class="lesson-main">
      <nav class="crumbs" aria-label="面包屑" data-pagefind-ignore>
        <a href={url('resources/')}>资源</a>
        <span aria-hidden="true">›</span>
        <a href={url(`resources/#kind-${d.kind}`)}>{d.kind}</a>
      </nav>

      <header class="page-head">
        <h1>{d.title}</h1>
        <div class="meta-row">
          <span class="pill">{d.kind}</span>
          <span class="pill">核实于 {d.verified}</span>
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      <SourceBadge sources={d.sources} verified={d.verified} />

      <nav class="pager" aria-label="返回" data-pagefind-ignore>
        <a class="pager-link" href={url(`resources/#kind-${d.kind}`)}>
          <span class="pager-label"><Icon name="arrow-left" size={16} />返回</span>
          <span class="pager-title">资源的「{d.kind}」分类</span>
        </a>
      </nav>
    </article>
  </div>
</Base>
