---
import Base from '../../layouts/Base.astro';
import Icon, { type IconName } from '../../components/Icon.astro';
import { getCollection } from 'astro:content';
import { RESOURCE_KINDS } from '../../content.config';
import { url } from '../../lib/env';

const entries = (await getCollection('resources')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
const byKind = new Map<string, typeof entries>();
for (const e of entries) {
  if (!byKind.has(e.data.kind)) byKind.set(e.data.kind, []);
  byKind.get(e.data.kind)!.push(e);
}
const ordered = [...byKind.entries()].sort(
  ([a], [b]) => RESOURCE_KINDS.indexOf(a as (typeof RESOURCE_KINDS)[number]) - RESOURCE_KINDS.indexOf(b as (typeof RESOURCE_KINDS)[number]),
);
const KIND_ICON: Record<string, IconName> = {
  模型文件: 'box',
  工具: 'wrench',
  链接: 'link',
  模板: 'clipboard-check',
  误区: 'triangle-alert',
  基线: 'sliders',
  概念: 'lightbulb',
};
/** 摘要：去掉代码块、表格分隔行、链接语法与强调符等 Markdown 记号后再截断 */
const plain = (s: string) =>
  s
    .replace(/`{3,}[\s\S]*$/g, '')
    .replace(/^[ \t]*\|?[ \t|:\-]*-{3,}[ \t|:\-]*\|?[ \t]*$/gm, '')
    .replace(/!?:?\[([^\]]*)\]\([^)]*\)/g, '$1').replace(/[*`#>|]/g, '').replace(/\s+/g, ' ').trim();
const excerpt = (body: string | undefined) => {
  const text = plain(body ?? '');
  return text.length > 110 ? `${text.slice(0, 110)}…` : text;
};
---

<Base title="资源" description="参数基线、启动参数、模型文件清单、提示词模板、常见误区、工具与链接，以及换模型时什么不变、什么要换。" active="resources" wide>
  <header class="page-head">
    <h1>资源</h1>
    <p class="lead">
      这里的数值都是<strong>起点值</strong>：来自模型卡、官方模板与源码，社区数值只当起点，结论以你自己的固定种子对照图为准。
    </p>
    <nav class="cat-nav" aria-label="资源分类">
      {ordered.map(([kind, list]) => (
        <a class="chip" href={`#kind-${kind}`}>
          {kind}<span class="chip-n">{list.length}</span>
        </a>
      ))}
    </nav>
  </header>

  {ordered.map(([kind, list]) => (
    <section class="dict-group" id={`kind-${kind}`} aria-labelledby={`kind-h-${kind}`}>
      <h2 id={`kind-h-${kind}`}>
        {kind}<span class="chip-n">{list.length} 篇</span>
      </h2>
      <div class="cards">
        {list.map((e) => (
          <a class="card" href={url(`resources/${e.id}/`)}>
            <span class="card-icon"><Icon name={KIND_ICON[kind] ?? 'folder'} /></span>
            <h3>{e.data.title}</h3>
            <p>{excerpt(e.body)}</p>
            <div class="meta"><span class="verified">核实于 {e.data.verified}</span></div>
            <span class="card-arrow"><Icon name="arrow-right" size={18} /></span>
          </a>
        ))}
      </div>
    </section>
  ))}
</Base>
